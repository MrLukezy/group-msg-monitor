# OneBot / NapCat
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=CHANGE_ME_TO_A_STRONG_RANDOM_TOKEN

# 兼容旧版全局群号（优先使用桌面端分群配置 data/group_configs）
MONITOR_GROUP_IDS=

MONITOR_KEYWORDS=
MONITOR_LOG_ALL=true
STORAGE_ENABLED=true
STORAGE_SQLITE_PATH=./data/messages.db
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=

LOG_LEVEL=INFO
LOG_DIR=./logs

# Cursor SDK（可选）
# CURSOR_API_KEY=
