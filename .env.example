# OneBot / NapCat 连接（也可用 config.yaml 配置，环境变量优先）
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=CHANGE_ME_TO_A_STRONG_RANDOM_TOKEN

# 监控目标群（逗号分隔）
MONITOR_GROUP_IDS=123456789

# 关键词告警（逗号分隔，可留空）
MONITOR_KEYWORDS=报警,紧急

# 是否记录目标群全部消息
MONITOR_LOG_ALL=true

# SQLite 落库
STORAGE_ENABLED=true
STORAGE_SQLITE_PATH=./data/messages.db

# Webhook 告警（飞书/钉钉/自建等）
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs
